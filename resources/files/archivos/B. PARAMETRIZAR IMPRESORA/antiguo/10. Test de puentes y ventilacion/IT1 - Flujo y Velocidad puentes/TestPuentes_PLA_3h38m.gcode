; machine_end_gcode = ; JP GENIUS Gcode Fin\n\n;Configuracion final ---------------------------\nG4 ;                                espera que acabe la última instrucción\nG92 E0;                         prepara para la retracción\nG1 E-1 F3000;             retrae para evitar hilillos\n\n;Presentar cama y elevar boquilla\nG91 ;                             coordenas relativas\nG1 X1 Y1 F1200 ;        presenta la cama\n{if layer_z < printable_height}\n  G1 Z{min(layer_z + 80, printable_height)}\n{endif} ;                        eleva la boquilla 80mm o a la maxima altura imprimible\nG90 ;                            coordenadas absolutas\n\n;Reset configuraciones -------------------------\nM220 S100   ;                  reset factor de velocidad\nM221 S100   ;                  reset extrusor rate\n\n;Apagados varios -------------------------------\nM106 S0;                         Apagar ventilador (fan)\nM104 S0;                         Apagar Hotend\nM140 S0;                         Apagar Bed\nM150 P0;                         Apagar LED\nM85 s0 ;                           Desactiva todo\nM84;                                 Apaga todos los motores\n\n\nG91; Relative positionning\nG1 E-2 Z0.2 F2400; Retract and raise Z\nG1 X5 Y5 F3000; Wipe out\nG1 Z10; Raise Z more\nG90; Absolute positionning\nG1 X0 Y100; Present print\nM106 S0; Turn-off fan\nM104 S0; Turn-off hotend\nM140 S0; Turn-off bed\n\nM84 X Y E; Disable all steppers but Z
; machine_load_filament_time = 0
; machine_max_acceleration_e = 8000,5000
; machine_max_acceleration_extruding = 1300,1250
; machine_max_acceleration_retracting = 3000,1250
; machine_max_acceleration_travel = 2000,1250
; machine_max_acceleration_x = 2000,1000
; machine_max_acceleration_y = 2000,1000
